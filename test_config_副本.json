import math

def calculate_sine(angle_degrees):
    """计算正弦值"""
    return math.sin(math.radians(angle_degrees))

def calculate_cosine(angle_degrees):
    """计算余弦值"""
    return math.cos(math.radians(angle_degrees))

def calculate_tangent(angle_degrees):
    """计算正切值"""
    return math.tan(math.radians(angle_degrees))

# 使用示例
angle = 30
print(f"sin({angle}°) = {calculate_sine(angle)}")
print(f"cos({angle}°) = {calculate_cosine(angle)}")
print(f"tan({angle}°) = {calculate_tangent(angle)}")

